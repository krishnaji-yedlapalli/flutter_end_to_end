{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dash",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--flavor",
                "dash"
            ]
        },
        {
            "name": "Flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--flavor",
                "flutter"
            ]
        },
        {
            "name": "Dart",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--flavor",
                "dart"
            ]
        },
        {
            "name": "Daily Tracker",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--flavor",
                "dailyTracker"
            ]
        },
        {
            "name": "Attach to Firebase Functions",
            "type": "node",
            "request": "attach",
            "port": 9229, // Default debug port for Node.js
            "address": "localhost",
            "restart": true,
            "protocol": "inspector",
            "localRoot": "${workspaceFolder}/functions", // Path to your functions directory
            "remoteRoot": "/workspace", // This is the default working directory inside the emulator
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}